{
  "train_data": "zhihu_train.jsonl",
  "validation_data": "zhihu_valid.jsonl",
  "hf_model_name_or_path": "openbmb/MiniCPM4-0.5B",
  "batch_size": 8,
  "num_workers": 0,
  "max_source_length": 1024,
  "max_target_length": 1024,
  "local_files_only": false,
  "trust_remote_code": true,
  "hf_dtype": "float32",
  "freeze_embeddings": false,
  "alpha": 0.5,
  "beta": 0.5,
  "random_delete_prob": 0.3,
  "label_smoothing": 0.1,
  "learning_rate": 0.0005,
  "weight_decay": 0.01,
  "betas": [0.9, 0.999],
  "eps": 1e-8,
  "muon_lr": 0.02,
  "muon_weight_decay": 0.01,
  "muon_momentum": 0.95,
  "muon_nesterov": true,
  "muon_ns_steps": 5,
  "warmup_steps": 10000,
  "max_training_steps": 300000,
  "epochs": 1,
  "seed": 1,
  "device": "auto",
  "amp_dtype": "none",
  "gradient_accumulation_steps": 1,
  "max_grad_norm": 1.0,
  "log_every_steps": 100,
  "validate_every_steps": 1000,
  "checkpoint_every_steps": 1000,
  "checkpoint_dir": "checkpoints",
  "resume_from": null
}
